      if (!cards.length) return;

      isFlipped = !isFlipped;
      document.getElementById('cardText').innerText = isFlipped ? cards[currentCardIndex].a : cards[currentCardIndex].q;
    }

    function nextCard() {
      const cards = getActiveFlashcards();
      if (!cards.length) return;

      currentCardIndex = (currentCardIndex + 1) % cards.length;
      showCard();
    }

    function prevCard() {
      const cards = getActiveFlashcards();
      if (!cards.length) return;

      currentCardIndex = (currentCardIndex - 1 + cards.length) % cards.length;
      showCard();
    }

    // Expose functions to window
    window.goHome = goHome;
    window.toggleCategory = toggleCategory;
    window.renderTopicList = renderTopicList;
    window.switchTopic = switchTopic;
    window.openUploadModal = openUploadModal;
    window.closeUploadModal = closeUploadModal;
    window.updateTextStats = updateTextStats;
    window.handleFileSelect = handleFileSelect;
    window.handleNoteGeneration = handleNoteGeneration;
    window.downloadPDF = downloadPDF;
    window.filterNotes = filterNotes;
    window.toggleHighYield = toggleHighYield;
    window.toggleFlashcardModal = toggleFlashcardModal;
    window.flipCard = flipCard;
    window.nextCard = nextCard;
    window.prevCard = prevCard;
    window.confirmResetStorage = confirmResetStorage;
    window.deleteTopic = deleteTopic;
    window.exportVault = exportVault;
    window.importVault = importVault;

    // Start App
    initFirebase();
  </script>
</body>
</html>

