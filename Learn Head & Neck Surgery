      statusText.innerText = "Processing document with Gemini AI Engine...";
      lucide.createIcons();

      const systemPrompt = `You are a world-class surgical educator, topper, note maker, and medical instruction designer specializing in Head & Neck Surgery study notes.
Transform the provided surgical text into a comprehensive, highly structured JSON payload for rendering as aesthetic handwritten medical study notes.

STRICT NO-LOSS & EXHAUSTIVE CONTENT RULES:
1. NO-LOSS / NO AGGRESSIVE SUMMARIZATION POLICY: Do NOT summarize too much, condense, or omit information. Retain ALL factual details, clinical features, anatomical boundaries, staging criteria, surgical steps, drug names/dosages, complications, and nuances from the source text. Every key concept and detail MUST be preserved.
2. Structure and organize the full text into as many detailed, logical sections as necessary (3 to 10+ sections).
3. Underline key terms, pathognomonic signs, diagnostic tests, and dates using <span class="underline-wavy">term</span> or <span class="emphasis-red">critical point</span>.
4. MANDATORY VISUAL DIAGRAMS & FLOWCHARTS: Wherever algorithms, diagnostic pathways, staging systems, anatomical relationships, or surgical steps are mentioned, create visual HTML/SVG diagrams or flowcharts using styled nodes (e.g. '<div class="bg-slate-50 p-4 rounded-xl border border-slate-200 my-4"><h4 class="text-xs uppercase font-bold text-slate-500 mb-3 tracking-wider text-center font-sans font-bold">Algorithm / Pathway Diagram</h4><div class="flex flex-col md:flex-row items-center justify-between gap-2 text-xs font-sans"><div class="flow-node">Step 1</div><div class="flow-arrow">➔</div><div class="flow-node">Step 2</div></div></div>') or inline SVG schematics.
5. Convert comparisons, classifications, or metrics into neat HTML tables formatted as: <table class="w-full notes-table text-sm"><thead><tr><th>Header1</th><th>Header2</th></tr></thead><tbody class="handwritten-text"><tr><td>Data</td><td>Data</td></tr></tbody></table>
6. Enclose critical safety warnings/contraindications in: <div class="callout-warning p-4 mb-4"><p class="text-sm text-red-900 handwritten-text"><strong>Warning:</strong> ...</p></div>
7. Enclose clinical pearls in: <div class="callout-note p-4 mb-4"><p class="text-sm text-sky-900 handwritten-text"><strong>> [!NOTE] Pearl:</strong> ...</p></div>
8. Provide EXPLICITLY EXACTLY 10 high-yield summary points ("summaryPoints") highlighting the 10 most critical takeaways to remember at the end of the note without reducing the depth of the main section content.
9. Create 4-6 interactive flashcards for self-assessment.`;

      const userPrompt = `Topic Title: ${title}\nCategory: ${selectedCategory}\n\nSurgical Content:\n${rawText}`;

      const jsonSchema = {
        type: "OBJECT",
        properties: {
          title: { type: "STRING" },
          category: { type: "STRING" },
          subtitle: { type: "STRING" },
          origin: { type: "STRING" },
          intro: { type: "STRING" },
          sections: {
            type: "ARRAY",
            items: {
              type: "OBJECT",
              properties: {
                id: { type: "STRING" },
                title: { type: "STRING" },
                icon: { type: "STRING" },
                html: { type: "STRING" }
              },
              required: ["id", "title", "icon", "html"]
            }
          },
          summaryPoints: {
            type: "ARRAY",
            items: { type: "STRING" },
            description: "Exactly 10 high-yield key takeaways / important points to remember about the topic"
          },
          flashcards: {
            type: "ARRAY",
            items: {
              type: "OBJECT",
              properties: {
                q: { type: "STRING" },
                a: { type: "STRING" }
              },
              required: ["q", "a"]
            }
          }
        },
        required: ["title", "category", "subtitle", "origin", "intro", "sections", "summaryPoints", "flashcards"]
      };

      const payload = {
        contents: [{ parts: [{ text: userPrompt }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: jsonSchema,
