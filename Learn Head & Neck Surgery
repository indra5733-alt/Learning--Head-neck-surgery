    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;

      document.getElementById('fileNameLabel').innerText = `Selected: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
      if (!document.getElementById('topicTitleInput').value) {
        document.getElementById('topicTitleInput').value = file.name.replace(/\.[^/.]+$/, "");
      }

      const fileName = file.name.toLowerCase();
      const spinner = document.getElementById('extractionSpinner');
      const spinnerText = document.getElementById('spinnerText');

      if (fileName.endsWith('.pdf')) {
        spinner.classList.remove('hidden');
        spinnerText.innerText = "Opening PDF file...";
        const reader = new FileReader();
        reader.onload = async function(e) {
          try {
            const typedarray = new Uint8Array(e.target.result);
            if (!window.pdfjsLib) throw new Error("PDF parser library not loaded.");
            const pdf = await pdfjsLib.getDocument({ data: typedarray }).promise;
            let textBuilder = '';
            for (let i = 1; i <= pdf.numPages; i++) {
              spinnerText.innerText = `Reading page ${i} of ${pdf.numPages}...`;
              const page = await pdf.getPage(i);
              const textContent = await page.getTextContent();
              const pageText = textContent.items.map(item => item.str).join(' ');
              textBuilder += `--- Page ${i} ---\n` + pageText + '\n\n';
            }
            document.getElementById('rawTextInput').value = textBuilder.trim();
            updateTextStats();
          } catch (err) {
            alert("Could not extract text from PDF. Please copy and paste text manually.");
          } finally {
            spinner.classList.add('hidden');
          }
        };
        reader.readAsArrayBuffer(file);
      } else if (fileName.endsWith('.docx') || fileName.endsWith('.doc')) {
        spinner.classList.remove('hidden');
        spinnerText.innerText = "Parsing Word document...";
        const reader = new FileReader();
        reader.onload = function(e) {
          const arrayBuffer = e.target.result;
          if (window.mammoth) {
            mammoth.extractRawText({ arrayBuffer: arrayBuffer })
              .then(function(result) {
                document.getElementById('rawTextInput').value = result.value;
                updateTextStats();
                spinner.classList.add('hidden');
              })
              .catch(function() {
                readAsPlainText(file);
                spinner.classList.add('hidden');
              });
          } else {
            readAsPlainText(file);
            spinner.classList.add('hidden');
          }
        };
        reader.readAsArrayBuffer(file);
      } else {
        readAsPlainText(file);
      }
    }

    function readAsPlainText(file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('rawTextInput').value = e.target.result;
        updateTextStats();
      };
      reader.readAsText(file);
    }

    async function callGeminiApi(payload) {
      const apiKey = "";
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
      const delays = [1000, 2000, 4000, 8000, 16000];

      for (let attempt = 0; attempt < 5; attempt++) {
        try {
          const response = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`Server returned status ${response.status}`);
          return await response.json();
        } catch (err) {
          if (attempt === 4) throw err;
          await new Promise(res => setTimeout(res, delays[attempt]));
        }
      }
    }

    async function handleNoteGeneration(event) {
      event.preventDefault();
      
      const title = document.getElementById('topicTitleInput').value || 'Head & Neck Surgical Topic';
      const selectedCategory = document.getElementById('topicCategorySelect').value || 'Miscellaneous / Others';
      const rawText = document.getElementById('rawTextInput').value;
