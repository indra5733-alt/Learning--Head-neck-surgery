<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Learning Head and Neck Surgery Easy</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts for Handwritten Aesthetic & Readability -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Kalam:wght@400;700&family=Patrick+Hand&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- HTML2PDF Library for Direct PDF Exporting -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <!-- Mammoth.js for Word (.docx / .doc) Text Extraction -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <!-- PDF.js for PDF Text Extraction -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  
  <style>
    /* Design Tokens & Theme Variable Rules */
    :root {
      --color-royal-blue: #1e40af;
      --color-dark-cyan: #0e7490;
      --color-crimson: #dc2626;
      --bg-paper: #faf8f5;
      --grid-line: #e2e8f0;
      --font-heading: 'Kalam', cursive;
      --font-subheading: 'Kalam', cursive;
      --font-handwriting: 'Patrick Hand', cursive, sans-serif;
      --font-body: 'Nunito', sans-serif;
    }

    body {
      background-color: var(--bg-paper);
      background-image: 
        linear-gradient(to right, rgba(226, 232, 240, 0.4) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(226, 232, 240, 0.4) 1px, transparent 1px);
      background-size: 24px 24px;
      font-family: var(--font-body);
      color: #1f2937;
    }

    /* Headings */
    .heading-royal {
      color: var(--color-royal-blue);
      font-family: var(--font-heading);
      font-weight: 700;
    }

    .subheading-cyan {
      color: var(--color-dark-cyan);
      font-family: var(--font-subheading);
      font-weight: 700;
    }

    .handwritten-text {
      font-family: var(--font-handwriting);
      font-size: 1.15rem;
      line-height: 1.6;
    }

    /* Emphasis and Highlights */
    .emphasis-red {
      color: var(--color-crimson);
      font-weight: 700;
    }

    .underline-wavy {
      text-decoration-line: underline;
      text-decoration-style: wavy;
      text-decoration-color: var(--color-crimson);
      text-decoration-thickness: 1.5px;
      font-weight: 700;
    }

    .high-yield-badge {
      background-color: #fef3c7;
      border: 1px solid #f59e0b;
      color: #92400e;
      font-family: var(--font-handwriting);
    }

    /* Callout Boxes */
    .callout-note {
      background-color: #f0f9ff;
      border-left: 5px solid #0284c7;
      border-radius: 0 8px 8px 0;
      box-shadow: 2px 2px 8px rgba(0,0,0,0.03);
    }

    .callout-warning {
      background-color: #fef2f2;
      border-left: 5px solid #dc2626;
      border-radius: 0 8px 8px 0;
      box-shadow: 2px 2px 8px rgba(0,0,0,0.03);
    }

    .callout-tip {
      background-color: #f0fdf4;
      border-left: 5px solid #16a34a;
      border-radius: 0 8px 8px 0;
      box-shadow: 2px 2px 8px rgba(0,0,0,0.03);
    }

    /* Flowchart Node & Arrow Styling */
    .flow-node {
      background: #ffffff;
      border: 2px solid var(--color-dark-cyan);
      border-radius: 8px;
      padding: 8px 12px;
      font-family: var(--font-handwriting);
      font-size: 1.05rem;
      font-weight: bold;
      text-align: center;
      box-shadow: 2px 2px 6px rgba(0,0,0,0.04);
      color: #0f172a;
    }

    .flow-arrow {
      color: var(--color-royal-blue);
      font-weight: bold;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }

    /* Table Styling */
    .notes-table {
      border-collapse: separate;
      border-spacing: 0;
      border: 2px solid #cbd5e1;
      border-radius: 8px;
      overflow: hidden;
    }

    .notes-table th {
      background-color: #f1f5f9;
      color: var(--color-royal-blue);
      font-family: var(--font-heading);
      font-size: 1.1rem;
      border-bottom: 2px solid #cbd5e1;
      padding: 10px 14px;
    }

    .notes-table td {
      border-bottom: 1px solid #e2e8f0;
      padding: 10px 14px;
    }

    .notes-table tr:last-child td {
      border-bottom: none;
    }

    .notes-table tr:nth-child(even) {
      background-color: rgba(255, 255, 255, 0.7);
    }

    /* Card Notebook Styling */
    .notebook-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      box-shadow: 3px 3px 12px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
      position: relative;
    }

    .notebook-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      border-radius: 12px 0 0 12px;
      background: linear-gradient(to bottom, var(--color-royal-blue), var(--color-dark-cyan));
    }

    /* Print Stylesheet for PDF Export */
    @media print {
      body {
        background: #ffffff !important;
        background-image: none !important;
        color: #000000 !important;
        font-size: 11pt;
      }

      .no-print {
        display: none !important;
      }

      .notebook-card {
        border: 1px solid #ccc !important;
        box-shadow: none !important;
        page-break-inside: avoid;
        margin-bottom: 1.5rem !important;
      }

      .notebook-card::before {
        display: none;
      }

      .heading-royal {
        color: #1e3a8a !important;
      }

      .subheading-cyan {
        color: #0e7490 !important;
      }

      .underline-wavy {
        text-decoration: underline !important;
        color: #b91c1c !important;
      }

      a {
        text-decoration: none !important;
        color: inherit !important;
      }

      @page {
        margin: 1.5cm;
      }
    }
  </style>
</head>
<body class="min-h-screen pb-16">

  <!-- TOP APP NAVIGATION BAR (NO-PRINT) -->
  <header class="no-print sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <!-- Home Button -->
        <button onclick="goHome()" title="Go to Home" class="p-2 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded-lg transition flex items-center justify-center">
          <i data-lucide="home" class="w-5 h-5"></i>
        </button>
        <div>
          <h1 class="text-base sm:text-lg font-bold text-slate-800 leading-tight">Learning Head and Neck Surgery Easy</h1>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium flex items-center space-x-1">
            <span id="syncStatusBadge" class="inline-flex items-center text-emerald-600 font-semibold">
              <i data-lucide="cloud-check" class="w-3 h-3 mr-1"></i> Auto-Synced Vault
            </span>
          </p>
        </div>
      </div>

      <!-- Controls -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- Upload / New Topic Button -->
        <button onclick="openUploadModal()" class="flex items-center space-x-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm rounded-lg shadow-sm transition">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>+ Upload / New Topic</span>
        </button>

        <!-- Search Box -->
        <div class="relative hidden lg:block w-44">
          <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="searchInput" onkeyup="filterNotes()" placeholder="Search terms..." 
            class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-100 border border-slate-200 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
        </div>

        <!-- High Yield Filter Toggle -->
        <button onclick="toggleHighYield()" id="hyBtn" class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 rounded-lg hover:bg-amber-100 transition">
          <i data-lucide="sparkles" class="w-4 h-4 text-amber-600"></i>
          <span>Highlight HY</span>
        </button>

        <!-- Direct PDF Download Button -->
        <button id="downloadPdfBtn" onclick="downloadPDF()" class="flex items-center space-x-2 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs sm:text-sm rounded-lg shadow-sm transition">
          <i data-lucide="file-down" class="w-4 h-4"></i>
          <span>Download PDF</span>
        </button>

        <!-- Print / Browser PDF Button -->
        <button onclick="window.print()" class="hidden md:flex items-center space-x-2 px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white font-medium text-xs sm:text-sm rounded-lg shadow-sm transition">
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>Print</span>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN WRAPPER -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 grid grid-cols-1 lg:grid-cols-4 gap-8">

    <!-- SIDEBAR NAVIGATION (NO-PRINT) -->
    <aside class="no-print lg:col-span-1 space-y-6">
      <!-- TOPIC LIBRARY WITH CATEGORY FILTER -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-3 border-b pb-2">
          <h3 class="font-bold text-slate-800 flex items-center space-x-2 text-sm">
            <i data-lucide="folder-kanban" class="w-4 h-4 text-blue-600"></i>
            <span>Surgical Topics Library</span>
          </h3>
          <span id="topicCountBadge" class="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-semibold">0 Topics</span>
        </div>

        <!-- Category Filter Selector -->
        <div class="mb-3">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Filter Category</label>
          <select id="categoryFilterSelect" onchange="renderTopicList()" class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-blue-500 font-semibold text-slate-700">
            <!-- Populated by JS -->
          </select>
        </div>

        <!-- Collapsible Category Tabs Container -->
        <div id="topicList" class="space-y-2 text-xs sm:text-sm font-medium max-h-[40vh] overflow-y-auto pr-1">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- ACTIVE TOPIC TABLE OF CONTENTS -->
      <div class="sticky top-24 bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-4">
        <div>
          <h3 class="font-bold text-slate-700 mb-3 flex items-center space-x-2 border-b pb-2 text-sm">
            <i data-lucide="list-tree" class="w-4 h-4 text-cyan-600"></i>
            <span>Topic Index</span>
          </h3>
          <nav id="sectionToc" class="space-y-1 text-xs sm:text-sm font-medium text-slate-600 max-h-[20vh] overflow-y-auto">
            <!-- Populated by JS -->
          </nav>
        </div>

        <!-- Quick Flashcards Toggle -->
        <div class="pt-2 border-t border-slate-100">
          <button onclick="toggleFlashcardModal()" class="w-full flex items-center justify-center space-x-2 py-2 px-3 bg-cyan-50 text-cyan-800 border border-cyan-200 rounded-lg text-xs font-semibold hover:bg-cyan-100 transition">
            <i data-lucide="brain-circuit" class="w-4 h-4"></i>
            <span>Interactive Self-Quiz</span>
          </button>
        </div>

        <!-- Backup Vault Export / Import / Reset -->
        <div class="pt-3 border-t border-slate-100 space-y-2 text-xs">
          <div class="flex items-center justify-between font-bold text-slate-700 text-[11px] uppercase tracking-wider">
            <span class="flex items-center space-x-1">
              <i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-600"></i>
              <span>Vault Backup & Data</span>
            </span>
          </div>
          
          <div class="grid grid-cols-2 gap-2">
            <button onclick="exportVault()" class="flex items-center justify-center space-x-1 px-2 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg text-[11px] transition">
              <i data-lucide="download" class="w-3 h-3 text-slate-600"></i>
              <span>Export Vault</span>
            </button>
            <label class="flex items-center justify-center space-x-1 px-2 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-800 font-medium rounded-lg text-[11px] cursor-pointer transition">
              <i data-lucide="upload" class="w-3 h-3 text-blue-600"></i>
              <span>Import Vault</span>
              <input type="file" accept=".json" onchange="importVault(event)" class="hidden">
            </label>
          </div>

          <button onclick="confirmResetStorage()" class="w-full text-center text-red-600 hover:text-red-800 font-semibold text-[10px] underline pt-1 block">
            Reset Default Data
          </button>
        </div>
      </div>
    </aside>

    <!-- MAIN STUDY NOTES CONTAINER -->
    <main class="lg:col-span-3 space-y-8" id="notesContent">
      <!-- Active Note dynamically rendered here by JS -->
    </main>
  </div>

  <!-- UPLOAD / AI NOTE GENERATOR MODAL (NO-PRINT) -->
  <div id="uploadModal" class="no-print fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 relative max-h-[90vh] overflow-y-auto">
      <button onclick="closeUploadModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>

      <div class="flex items-center space-x-3 text-blue-700 mb-4 border-b pb-3">
        <div class="p-2 bg-blue-100 rounded-lg">
          <i data-lucide="sparkles" class="w-5 h-5 text-blue-600"></i>
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">Auto-Format Surgical Study Notes</h3>
          <p class="text-xs text-slate-500">Exhaustive detail preservation: Retains ALL concepts, boundaries & guidelines without over-summarizing!</p>
        </div>
      </div>

      <form id="uploadForm" onsubmit="handleNoteGeneration(event)" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Topic Title -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Topic Title</label>
            <input type="text" id="topicTitleInput" placeholder="e.g. Pleomorphic Adenoma of Parotid Gland" 
              class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <!-- Category Selector -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Select Category</label>
            <select id="topicCategorySelect" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium">
              <!-- Populated by JS -->
            </select>
          </div>
        </div>

        <!-- File Upload or Direct Paste -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- File Upload Box -->
          <div class="border-2 border-dashed border-slate-200 hover:border-blue-400 rounded-xl p-4 text-center bg-slate-50 transition cursor-pointer relative">
            <input type="file" id="fileInput" accept=".pdf,.docx,.doc,.txt,.md,.json" onchange="handleFileSelect(event)" class="absolute inset-0 opacity-0 cursor-pointer">
            <i data-lucide="file-up" class="w-8 h-8 mx-auto text-blue-500 mb-2"></i>
            <span id="fileNameLabel" class="text-xs font-semibold text-slate-600 block">Upload Large PDF (.pdf), Word (.docx, .doc), or Text (.txt, .md)</span>
            <span class="text-[10px] text-slate-400">Supports multi-page documents & long chapters</span>
          </div>

          <!-- Quick Tip Box -->
          <div class="bg-amber-50 p-3 rounded-xl border border-amber-200 text-xs text-amber-900 space-y-1">
            <span class="font-bold flex items-center space-x-1">
              <i data-lucide="shield-alert" class="w-4 h-4 text-amber-600"></i>
              <span>No-Loss Detail Policy:</span>
            </span>
            <p>The AI is strictly configured <strong>NOT to condense or skip information</strong>. Every anatomical boundary, dosage, step, and staging nuance is formatted into detailed sections!</p>
          </div>
        </div>

        <!-- Raw Text Input & Live Word Counter -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide">Extracted Note Text / Content</label>
            <div class="flex items-center space-x-2">
              <span id="extractionSpinner" class="hidden text-xs text-blue-600 flex items-center space-x-1 font-semibold">
                <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                <span id="spinnerText">Reading document...</span>
              </span>
              <span id="textStatsBadge" class="text-[11px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md border border-slate-200">
                0 words | 0 chars
              </span>
            </div>
          </div>
          <textarea id="rawTextInput" rows="8" oninput="updateTextStats()" placeholder="Extracted PDF / Word document content or pasted long text will appear here..." required
            class="w-full p-3 text-xs font-mono bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 leading-relaxed"></textarea>
        </div>

        <!-- Submit Button & Loader -->
        <div class="pt-2 flex items-center justify-between">
          <span id="statusText" class="text-xs text-slate-500 font-medium">Ready to format</span>
          <button type="submit" id="generateBtn" class="flex items-center space-x-2 px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-lg shadow transition">
            <i data-lucide="wand-2" class="w-4 h-4"></i>
            <span>Generate & Save Notes</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- INTERACTIVE QUIZ / FLASHCARD MODAL (NO-PRINT) -->
  <div id="flashcardModal" class="no-print fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 relative">
      <button onclick="toggleFlashcardModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>

      <div class="flex items-center space-x-2 text-cyan-700 mb-4">
        <i data-lucide="sparkles" class="w-5 h-5"></i>
        <h3 class="font-bold text-lg">High-Yield Self-Assessment Flashcard</h3>
      </div>

      <div id="cardContent" class="min-h-[160px] flex items-center justify-center p-6 bg-slate-50 rounded-xl border border-slate-200 text-center cursor-pointer" onclick="flipCard()">
        <p id="cardText" class="text-lg font-bold text-slate-800 handwritten-text">
          Select a topic to launch flashcards.
        </p>
      </div>

      <div class="flex items-center justify-between mt-6">
        <span id="cardProgress" class="text-xs text-slate-400 font-mono">Card 1 of 4</span>
        <div class="space-x-2">
          <button onclick="prevCard()" class="px-3 py-1.5 text-xs font-semibold bg-slate-100 hover:bg-slate-200 rounded-lg text-slate-700">Previous</button>
          <button onclick="flipCard()" class="px-3 py-1.5 text-xs font-semibold bg-blue-100 hover:bg-blue-200 rounded-lg text-blue-800">Flip Card</button>
          <button onclick="nextCard()" class="px-3 py-1.5 text-xs font-semibold bg-blue-600 hover:bg-blue-700 rounded-lg text-white">Next Question</button>
        </div>
      </div>
    </div>
  </div>

  <!-- APPLICATION LOGIC WITH FIRESTORE & LOCAL STORAGE -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, collection, onSnapshot, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // Configure PDF.js Worker
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    const appId = typeof __app_id !== 'undefined' ? __app_id : 'learning-head-neck-surgery-easy';
    const STORAGE_KEY = 'head_neck_surgery_topics_v2';

    // Defined List of Head & Neck Surgery Categories
    const CATEGORIES = [
      "Basic sciences",
      "Anatomy",
      "Oral cavity",
      "Neck",
      "Thyroid",
      "Trachea",
      "Larynx",
      "Hypopharynx",
      "Salivary glands",
      "Flaps",
      "Reconstruction",
      "Radiotherapy",
      "Chemotherapy",
      "Immunotherapy",
      "Trials",
      "Surgery practical points",
      "Miscellaneous / Others"
    ];

    // Default Seed Data with Embedded Diagrams and Flowcharts
    const defaultSeedTopics = {
      'cbt': {
        id: 'cbt',
        title: 'Carotid Body Tumors (Chemodectomas)',
        category: 'Neck',
        subtitle: 'Complete Comprehensive Medical Study Guide & Practice Notes',
        origin: 'Origin: Parasympathetic Ganglia | Bifurcation of CCA',
        intro: 'Carotid Body Tumors (<span class="underline-wavy">CBTs</span>) are rare, highly vascularized neuroendocrine tumors arising from the non-chromaffin paraganglion cells located at the carotid artery bifurcation. This study guide outlines their clinical features, mandatory diagnostic algorithms, classification, and surgical strategies.',
        sections: [
          {
            id: 'clinical-presentation',
            icon: 'user-check',
            title: '1. Clinical Presentation & Physical Examination',
            html: `
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <h3 class="text-lg subheading-cyan mb-2">Physical Features & Location</h3>
                  <ul class="space-y-2 handwritten-text text-slate-800">
